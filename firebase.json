{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "storage.rules", "README.md", ".firebaserc", ".gitignore"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }] },
      { "source": "*.{js,css}", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }] }
    ]
  }
}
