{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "storage.rules",
      "README.md",
      ".firebaserc"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "*.{js,css}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300, public"
          }
        ]
      }
    ]
  }
}
